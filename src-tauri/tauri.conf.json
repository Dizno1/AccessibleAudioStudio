{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AccessibleAudioStudio Pro",
  "version": "0.1.8",
  "identifier": "org.opendoordesign.accessibleaudiostudio.pro",
  "build": {
    "frontendDist": "../dist",
    "devUrl": null,
    "beforeDevCommand": "node scripts/prepare-dist.js",
    "beforeBuildCommand": "node scripts/prepare-dist.js"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AccessibleAudioStudio Pro",
        "width": 1000,
        "height": 800,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true,
        "center": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Open Door Design",
    "copyright": "Open Door Design",
    "shortDescription": "Professional audio recording and editing for keyboard and screen reader users.",
    "longDescription": "AccessibleAudioStudio Pro is a professional audio recording and editing environment designed from the ground up for keyboard users and screen reader users, and fully usable by everyone. It installs alongside the free AccessibleAudioStudio rather than replacing it.",
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
